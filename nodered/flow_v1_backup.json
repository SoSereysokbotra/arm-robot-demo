  {
    "id": "fn_state",
    "type": "function",
    "z": "tab_arm",
    "name": "format angles",
    "func": "const names = {1:\"Shoulder\",2:\"Elbow\",3:\"Wrist P\",4:\"Wrist R\",5:\"Gripper\"};\nmsg.payload = Object.entries(msg.payload).map(([ch,a]) => `${names[ch]||\"CH\"+ch}: ${a}°`).join(\"  |  \");\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 740,
    "wires": [
      [
        "txt_state"
      ]
    ]
  },
