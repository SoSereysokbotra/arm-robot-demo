  {
    "id": "fn_presets",
    "type": "function",
    "z": "tab_arm",
    "name": "preset -> servo commands",
    "func": "// Edit these angles to match YOUR arm.  CH: 1 shoulder, 2 elbow, 3 wrist roll, 4 wrist pitch, 5 gripper\nconst presets = {\n    rest:  {1: 90,  2: 90,  3: 90,  4: 90,  5: 90},\n    pick:  {1: 120, 2: 60,  3: 40,  4: 90,  5: 20},\n    place: {1: 60,  2: 120, 3: 60,  4: 90,  5: 90},\n};\nconst name = msg.payload;\n\nif (name === \"home\") return { topic: \"arm/home\", payload: \"1\" };\n\nif (name === \"wave\") {   // demo: wrist roll back and forth\n    const steps = [[3, 40], [3, 140], [3, 40], [3, 140], [3, 90]];\n    steps.forEach(([ch, a], i) =>\n        setTimeout(() => node.send({ topic: \"arm/servo/\" + ch, payload: String(a) }), i * 700));\n    return null;\n}\n\nconst pose = presets[name];\nif (!pose) return null;\nreturn [Object.entries(pose).map(([ch, a]) => ({ topic: \"arm/servo/\" + ch, payload: String(a) }))];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 940,
    "wires": [
      [
        "mqtt_out"
      ]
    ]
  },
