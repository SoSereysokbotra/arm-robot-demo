    "func": "const t = new Date().toLocaleTimeString();\nconst lines = context.get(\"lines\") || [];\nlines.unshift(\"<font color=\\\"#888\\\"><small>\" + t + \"</small></font> \" + msg.payload);\nwhile (lines.length > 6) lines.pop();\ncontext.set(\"lines\", lines);\nmsg.payload = lines.join(\"<br/>\");\nreturn msg;\n",
